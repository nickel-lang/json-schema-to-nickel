let js2n = FAKE_JS2N_LIB in
let rec refs
    = {
      definitions.bar =
        std.contract.Sequence [ std.enum.TagOrString, [| 'two, 'one |] ],
      definitions.foo = { bar | refs.definitions.bar | optional, .. }
    }
    in
  { foo | refs.definitions.foo | optional, .. }
